# Paths are examples. Runtime fingerprints are checked before readiness.
IQ36_MODEL_ID=qwen3.6-35b-a3b-u4
IQ36_BACKEND=openvino
IQ36_DEVICE=GPU
IQ36_REPO_ROOT=/opt/iq36/runtime
IQ36_MODEL_DIR=/opt/iq36/model/Qwen3.6-35B-A3B-ov
IQ36_MODEL_VERIFICATION=full
IQ36_SHORT_PLUGIN=/opt/iq36/runtime/plugins/short/libopenvino_intel_gpu_plugin.so
IQ36_LONG_PLUGIN=/opt/iq36/runtime/plugins/long/libopenvino_intel_gpu_plugin.so
IQ36_CUSTOM_CONFIG=/opt/iq36/runtime/openvino/custom/iq36_hot_attention_gqa.xml
IQ36_OV_PYTHON=/opt/intel-qwen36/.venv/bin/python

IQ36_HOST=127.0.0.1
IQ36_PORT=8000
IQ36_MAX_REQUEST_BYTES=4194304
IQ36_MAX_CONTEXT_LENGTH=131584
IQ36_MAX_NEW_TOKENS=512
IQ36_MAX_QUEUE_DEPTH=8
IQ36_MAX_RESIDENT_WORKERS=1
IQ36_PREFIX_CACHE_BYTES=2147483648
IQ36_PREFIX_CACHE_ENTRIES=4
IQ36_PREFIX_CACHE_TTL=900
IQ36_RESPONSE_STORE_ENTRIES=256
IQ36_RESPONSE_STORE_BYTES=268435456
IQ36_RESPONSE_STORE_TTL=3600
IQ36_REQUEST_TIMEOUT=900
IQ36_CANCEL_GRACE=2
IQ36_SHUTDOWN_TIMEOUT=30
IQ36_KEEPALIVE_TIMEOUT=30
IQ36_PRELOAD_BUCKET=2048
IQ36_MIN_AVAILABLE_GIB=8
IQ36_ABORT_BELOW_AVAILABLE_GIB=4
IQ36_LOG_LEVEL=INFO

# Set only when browser clients call the service directly.
# IQ36_CORS_ORIGIN=https://example.invalid

# IQ36_API_KEY_FILE is supplied by the systemd credential in the unit example.
# For a foreground process, point it to a mode-0600 file instead of putting a
# secret in this environment file.
