+using CompressedFC = op::FullyConnectedCompressed;
+using CompressedFCVector = std::vector<std::shared_ptr<CompressedFC>>;
+
+CompressedFCVector get_compressed_fc_users(const std::shared_ptr<Node>& input) {
+    CompressedFCVector candidates;
+    for (const auto& user : input->get_users()) {
+        if (const auto& fc = ov::as_type_ptr<CompressedFC>(user))
+            candidates.push_back(fc);
+    }
+    return candidates;
+}
+
+CompressedFCVector get_locked_router_shared_fanout(const std::shared_ptr<Node>& input) {
+    auto candidates = get_compressed_fc_users(input);
+    const char* scope_value = std::getenv("IQ36_FIXED_FC_MANAGER_SCOPE");
+    if (!scope_value || std::string(scope_value) != "m1024")
+        return {};
+
+    // The locked fanout has four K=2048 FCs with N=[1, 512, 512, 256].
+    // Keep the scalar shared-expert gate and N=256 router independent;
+    // fuse only the two N=512 bulk projections.
+    if (candidates.size() != 4)
+        return {};
+
+    size_t n1_count = 0;
+    size_t n256_count = 0;
+    size_t n512_count = 0;
+    for (const auto& fc : candidates) {
+        const auto& weight_shape = fc->get_input_partial_shape(1);
+        if (!weight_shape.is_static() || weight_shape.size() != 2)
+            return {};
+        const auto shape = weight_shape.to_shape();
+        if (shape[1] != 2048)
+            return {};
+        if (shape[0] == 1) {
+            n1_count++;
+        } else if (shape[0] == 256) {
+            n256_count++;
+        } else if (shape[0] == 512) {
+            n512_count++;
+        } else {
+            return {};
+        }
+    }
+
+    if (n1_count != 1 || n256_count != 1 || n512_count != 2)
+        return {};
+
+    return candidates;
+}
+
+CompressedFCVector get_horizontal_fusion_candidates(const std::shared_ptr<Node>& input) {
+    auto candidates = get_compressed_fc_users(input);
+    const auto locked_fanout = get_locked_router_shared_fanout(input);
+    if (locked_fanout.empty())
+        return candidates;
+
+    CompressedFCVector shared_expert_candidates;
+    for (const auto& fc : locked_fanout) {
+        const auto shape = fc->get_input_shape(1);
+        if (shape[0] == 512)
+            shared_expert_candidates.push_back(fc);
+    }
+    return shared_expert_candidates;
+}
+
+void expand_locked_zero_points_to_u8(const std::shared_ptr<Node>& input) {
+    for (const auto& fc : get_locked_router_shared_fanout(input)) {
+        if (fc->get_input_shape(1)[0] != 512)
+            continue;
+        if (fc->inputs().size() <= 4 || fc->get_input_element_type(4) != ov::element::u4)
+            continue;
+        const auto zero_point = fc->input_value(4);
+        auto expanded = std::make_shared<ov::op::v0::Convert>(zero_point, ov::element::u8);
+        expanded->set_friendly_name(fc->get_friendly_name() + "_iq36_u8_zero_point");
+        ov::copy_runtime_info(zero_point.get_node_shared_ptr(), expanded);
+        fc->input(4).replace_source_output(expanded->output(0));
+    }
+}
