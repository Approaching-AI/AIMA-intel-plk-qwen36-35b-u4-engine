+}  // namespace
+
+IQ36FixedFCImplementationManager::IQ36FixedFCImplementationManager()
+    // Advertise the manager as oneDNN for graph-layout selection so the T1
+    // denominator keeps its proven oneDNN layouts.  The selected T>1
+    // primitive implementation itself remains an OpenCL microkernel.
+    : ImplementationManager(impl_types::onednn, shape_types::static_shape) {}
+
+bool IQ36FixedFCImplementationManager::validate_impl(const program_node& node) const {
+    if (!node.is_type<fully_connected>())
+        return false;
+    const auto& fc = node.as<fully_connected>();
+    const auto desc = fc.get_primitive();
+    if (desc->bias.is_valid() || !desc->decompression_scale.is_valid() ||
+        !desc->decompression_zero_point.is_valid() || desc->decompression_zero_point_scalar.has_value()) {
+        return false;
+    }
+    const bool dynamic_quantized = desc->dynamic_quantized_activation;
+    const size_t expected_dependencies = 4 + (dynamic_quantized ? 1 : 0) +
+        (desc->dynamic_quantized_activation_zp ? 1 : 0) +
+        (desc->dynamic_quantized_precomputed_reduction ? 1 : 0);
+    if (node.get_dependencies().size() != expected_dependencies)
+        return false;
+    const auto& weights = node.get_dependency(1).get_output_layout();
+    const auto& scales = node.get_dependency(2).get_output_layout();
+    const auto& zero_points = node.get_dependency(3).get_output_layout();
+    if (!weights.is_static() || !scales.is_static() || !zero_points.is_static() ||
+        weights.data_type != data_types::u4 || scales.data_type != data_types::f16 ||
+        zero_points.data_type != data_types::u8) {
+        return false;
+    }
+    const size_t weight_elements = logical_size(weights);
+    if (weight_elements == 0 || weight_elements % kK != 0)
+        return false;
+    const size_t width = weight_elements / kK;
+    if (!is_target_width(width) || logical_size(scales) != width * kGroups ||
+        logical_size(zero_points) != width * kGroups) {
+        return false;
+    }
+    if (dynamic_quantized && !node.get_dependency(0).is_type<dynamic_quantize>())
+        return false;
+    const auto& input = dynamic_quantized
+        ? node.get_dependency(0).get_dependency(0).get_output_layout()
+        : node.get_input_layout(0);
+    if (input.data_type != data_types::f16)
+        return false;
+    if (input.is_static() && logical_size(input) / kK <= 1)
+        return false;
+    return true;
+}
+
+bool IQ36FixedFCImplementationManager::support_shapes(const kernel_impl_params& params) const {
+    return has_exact_static_contract(params);
+}
+
+std::unique_ptr<primitive_impl> IQ36FixedFCImplementationManager::create_impl(
+    const program_node&, const kernel_impl_params& params) const {
+    size_t tokens = 0;
+    size_t width = 0;
+    if (!has_exact_static_contract(params, &tokens, &width))
+        return nullptr;
+    auto data = make_kernel_data(tokens, width);
+    trace_selection(params, tokens, width, data);
+    return std::make_unique<IQ36FixedFCImpl>(data);
+}
+
+in_out_fmts_t IQ36FixedFCImplementationManager::query_formats(const program_node&) const {
+    return {};
+}
