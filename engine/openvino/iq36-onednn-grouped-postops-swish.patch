new file mode 100644
index 0000000000..8fbf9f3367
--- /dev/null
+++ b/src/gpu/intel/matmul/grouped_post_ops_gen.cpp
@@ -0,0 +1,222 @@
+/*******************************************************************************
+* Copyright 2026 Intel Corporation
+*
+* Licensed under the Apache License, Version 2.0 (the "License");
