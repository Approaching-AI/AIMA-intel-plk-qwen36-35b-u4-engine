diff --git a/src/plugins/intel_gpu/src/graph/primitive_inst.cpp b/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
--- a/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
+++ b/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
@@ -1059,6 +1059,30 @@ void primitive_inst::realloc_outputs(bool prev_execution_skipped) {
         if (required_buffer_size * 10 < _max_output_layout_count[i]) {
             reclaim = true;
         }
+        // The locked IQ36 decode transition has batch size one and the FC
+        // output layout is already final. Preserve its sufficient prefill
+        // allocation instead of taking the generic 10x shrink/reallocate path.
+        // This is candidate-only and shares the isolated DQ reallocation gate.
+        bool iq36_exact_q1_fc_reuse = false;
+        if (iq36_dq_fastpath_env != nullptr &&
+            iq36_dq_fastpath_env[0] != '\0' &&
+            iq36_dq_fastpath_env[0] != '0' && reclaim && i == 0 &&
+            updated_layouts.size() == 1 &&
+            get_node().is_type<fully_connected>() && is_dynamic() &&
+            _outputs[i] &&
+            updated_layouts[i] == actual_layouts[i] &&
+            required_buffer_size <= _max_output_layout_count[i] &&
+            updated_layouts[i].data_padding._dynamic_dims_mask.none()) {
+            const auto input_shape =
+                _impl_params->get_input_layout().get_shape();
+            const auto batch_size = std::accumulate(
+                input_shape.begin(), input_shape.end() - 1, size_t{1},
+                std::multiplies<size_t>());
+            iq36_exact_q1_fc_reuse = batch_size == 1;
+        }
+        if (iq36_exact_q1_fc_reuse) {
+            reclaim = false;
+        }
         if (reclaim) {
             GPU_DEBUG_TRACE_DETAIL << id() << ": Updated output[" << i << "] size " << updated_layouts[i].get_linear_size()
                                    << " is much smaller than current memory size! " << _max_output_layout_count[i]
