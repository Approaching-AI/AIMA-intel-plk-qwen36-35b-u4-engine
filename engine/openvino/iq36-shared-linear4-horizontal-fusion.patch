 namespace ov::intel_gpu {
 
+namespace {
+
+using CompressedFC = op::FullyConnectedCompressed;
+using CompressedFCVector = std::vector<std::shared_ptr<CompressedFC>>;
+
+CompressedFCVector get_horizontal_fusion_candidates(const std::shared_ptr<Node>& input) {
+    CompressedFCVector candidates;
+    for (const auto& user : input->get_users()) {
+        if (const auto& fc = ov::as_type_ptr<CompressedFC>(user))
+            candidates.push_back(fc);
+    }
+
+    // The locked router/shared-expert fanout has four K=2048 compressed FCs
+    // with N=[1, 512, 512, 256]. Keep the N=256 routing branch independent:
+    // its output selects experts, while the other three outputs are one shared
+    // expert and can use the existing max-three horizontal fusion.
+    if (candidates.size() != 4)
+        return candidates;
+
+    size_t n1_count = 0;
+    size_t n256_count = 0;
+    size_t n512_count = 0;
+    std::shared_ptr<CompressedFC> router_fc;
+    for (const auto& fc : candidates) {
+        const auto& weight_shape = fc->get_input_partial_shape(1);
+        if (!weight_shape.is_static() || weight_shape.size() != 2)
+            return candidates;
+        const auto shape = weight_shape.to_shape();
+        if (shape[1] != 2048)
+            return candidates;
+        if (shape[0] == 1) {
+            n1_count++;
+        } else if (shape[0] == 256) {
+            n256_count++;
+            router_fc = fc;
+        } else if (shape[0] == 512) {
+            n512_count++;
+        } else {
+            return candidates;
+        }
+    }
+
+    if (n1_count != 1 || n256_count != 1 || n512_count != 2)
+        return candidates;
+
+    CompressedFCVector shared_expert_candidates;
+    for (const auto& fc : candidates) {
+        if (fc != router_fc)
+            shared_expert_candidates.push_back(fc);
+    }
+    return shared_expert_candidates;
+}
+
+bool is_exact_linear_four_group(const CompressedFCVector& candidates) {
+    if (candidates.size() != 4)
+        return false;
+
+    size_t n32_count = 0;
+    size_t n4096_count = 0;
+    size_t n8192_count = 0;
+    for (const auto& fc : candidates) {
+        const auto& weight_shape = fc->get_input_partial_shape(1);
+        if (!weight_shape.is_static() || weight_shape.size() != 2)
+            return false;
+        const auto shape = weight_shape.to_shape();
+        if (shape[1] != 2048)
+            return false;
+        if (shape[0] == 32) {
+            n32_count++;
+        } else if (shape[0] == 4096) {
+            n4096_count++;
+        } else if (shape[0] == 8192) {
+            n8192_count++;
+        } else {
+            return false;
+        }
+    }
+    return n32_count == 2 && n4096_count == 1 && n8192_count == 1;
+}
