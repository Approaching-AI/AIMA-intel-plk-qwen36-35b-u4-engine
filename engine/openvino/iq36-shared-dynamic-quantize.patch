 namespace ov::intel_gpu {
 
+namespace {
+
+using DynamicQuantize = ov::op::internal::DynamicQuantize;
+
+struct SharedDynamicQuantize {
+    std::shared_ptr<ov::Node> input_node;
+    size_t input_index;
+    DynamicQuantize::Attributes attrs;
+    std::shared_ptr<DynamicQuantize> operation;
+};
+
+bool same_attributes(const DynamicQuantize::Attributes& lhs,
+                     const DynamicQuantize::Attributes& rhs) {
+    return lhs.quantization_type == rhs.quantization_type &&
+           lhs.quantization_dt == rhs.quantization_dt &&
+           lhs.scale_dt == rhs.scale_dt &&
+           lhs.zp_dt == rhs.zp_dt &&
+           lhs.precomputed_reduction_dt == rhs.precomputed_reduction_dt &&
+           lhs.precomputed_reduction == rhs.precomputed_reduction &&
+           lhs.group_sizes == rhs.group_sizes &&
+           lhs.scales_zp_output_order == rhs.scales_zp_output_order &&
+           lhs.output_storage_type == rhs.output_storage_type;
+}
+
+}  // namespace
