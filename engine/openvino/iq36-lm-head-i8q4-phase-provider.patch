+bool has_exact_static_contract(const kernel_impl_params& params) {
+    if (!enabled() || params.desc->id != kNodeId || params.output_layouts.size() != 1 ||
+        params.has_fused_primitives()) {
+        return false;
+    }
+
+    const auto desc = params.typed_desc<fully_connected>();
+    if (desc->bias.is_valid() || !desc->compressed_weights ||
+        !desc->decompression_scale.is_valid() || desc->decompression_zero_point.is_valid() ||
+        desc->decompression_zero_point_scalar.has_value() || !desc->dynamic_quantized_activation ||
+        desc->dynamic_quantized_activation_zp || desc->dynamic_quantized_precomputed_reduction ||
+        !desc->activation_scale.is_valid() || desc->activation_zero_point.is_valid() ||
+        desc->activation_precomputed_reduction.is_valid()) {
+        return false;
+    }
+
+    // activation, weights, per-row weight scale, group-256 activation scale
+    if (params.input_layouts.size() != 4)
+        return false;
+    const auto& activation = params.get_input_layout(0);
+    const auto& weights = params.get_input_layout(1);
+    const auto& weight_scales = params.get_input_layout(2);
+    const auto& activation_scales = params.get_input_layout(3);
+    const auto& output = params.get_output_layout(0);
+    if (!activation.is_static() || !weights.is_static() || !weight_scales.is_static() ||
+        !activation_scales.is_static() || !output.is_static()) {
+        return false;
+    }
+    if (activation.data_type != data_types::f16 || weights.data_type != data_types::i8 ||
+        weight_scales.data_type != data_types::f16 || activation_scales.data_type != data_types::f16 ||
+        output.data_type != data_types::f16) {
+        return false;
+    }
+    if (logical_size(activation) != kColumns || logical_size(weights) != kRows * kColumns ||
+        logical_size(weight_scales) != kRows || logical_size(activation_scales) != 0 ||
+        logical_size(output) != kRows) {
+        return false;
+    }
+    if (activation.format != format::bfyx || weights.format != format::bfyx ||
+        activation_scales.format != format::bfyx || output.format != format::bfyx) {
+        return false;
+    }
+
+    const auto& device = params.get_device_info();
+    return device.ip_version == kTargetIpVersion && device.execution_units_count == kTargetEuCount;
+}
