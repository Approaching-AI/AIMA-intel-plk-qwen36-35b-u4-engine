+constexpr size_t kTopK = 8;
+constexpr size_t kRowsPerTopBlock = 256;
+constexpr size_t kTopBlockCount = kRows / kRowsPerTopBlock;
+constexpr size_t kBinaryCodeBytesPerStripe = 2048;
+constexpr size_t kBinaryStripeBytes = 2128;
+constexpr size_t kBinaryPackedBytes =
+    (kRows / kRowsPerStripe) * kBinaryStripeBytes;
+constexpr size_t kBinaryLocalTopK = 12;
+constexpr size_t kBinaryCorrectionRows = kTopBlockCount * kBinaryLocalTopK;
+constexpr uint32_t kTargetIpVersion = 0x07800004;
+constexpr uint32_t kTargetEuCount = 96;
