+    rerank.code.kernelString->entry_point = kOutputSelectKernelName;
+    rerank.code.kernelString->str = source;
+    rerank.code.kernelString->options =
+        "-cl-std=CL3.0 -D IQ36_OUTPUT_TOPK_KERNEL=1";
+    rerank.code.kernelString->batch_compilation = false;
+    rerank.params.workGroups.global = {kRows, 1, 1};
+    rerank.params.workGroups.local = {256, 1, 1};
+    rerank.params.arguments = {
+        {argument_type::OUTPUT, 0},
+        {argument_type::INTERNAL_BUFFER, 2},
+        {argument_type::INTERNAL_BUFFER, 3},
+    };
+
+    auto& second_merge = data.kernels[5];
+    second_merge.code.kernelString = std::make_shared<kernel_selector::kernel_string>();
+    second_merge.code.kernelString->entry_point = kMergeKernelName;
+    second_merge.code.kernelString->str = source;
+    second_merge.code.kernelString->options =
+        "-cl-std=CL3.0 -D IQ36_TOPK_MERGE_KERNEL=1";
+    second_merge.code.kernelString->batch_compilation = false;
+    second_merge.params.workGroups.global = {256, 1, 1};
+    second_merge.params.workGroups.local = {256, 1, 1};
+    second_merge.params.arguments = {
+        {argument_type::INTERNAL_BUFFER, 2},
+        {argument_type::INTERNAL_BUFFER, 3},
+        {argument_type::INTERNAL_BUFFER, 4},
+        {argument_type::INTERNAL_BUFFER, 5},
+    };
+
+    auto& second_correction = data.kernels[6];
+    second_correction.code.kernelString = std::make_shared<kernel_selector::kernel_string>();
+    second_correction.code.kernelString->entry_point = kDirectCorrectionKernelName;
+    second_correction.code.kernelString->str = source;
+    second_correction.code.kernelString->options =
+        "-cl-std=CL3.0 -D IQ36_DIRECT_CORRECTION_KERNEL=1";
+    second_correction.code.kernelString->batch_compilation = false;
+    second_correction.params.workGroups.global = {kTopK * 64, 1, 1};
+    second_correction.params.workGroups.local = {64, 1, 1};
+    second_correction.params.arguments = {
+        {argument_type::INPUT, 1},
+        {argument_type::INPUT, 2},
+        {argument_type::INPUT, 0},
+        {argument_type::INTERNAL_BUFFER, 4},
+        {argument_type::OUTPUT, 0},
+    };
+    data.internalBufferDataType = kernel_selector::Datatype::UINT8;
+    data.internalBuffers.emplace_back(kColumns);
+    data.internalBuffers.emplace_back(8 * sizeof(float));
+    data.internalBuffers.emplace_back(kTopBlockCount * kTopK * sizeof(int32_t));
+    data.internalBuffers.emplace_back(kTopBlockCount * kTopK * sizeof(float));
+    data.internalBuffers.emplace_back(kTopK * sizeof(int32_t));
+    data.internalBuffers.emplace_back(kTopK * sizeof(float));
+    data.needs_sub_kernels_sync = true;
+    return data;
+}
+
+void append_trace(const std::string& row) {
+    const char* path = std::getenv(
+        binary_enabled() ? "IQ36_LM_HEAD_I8Q1_TRACE_PATH" :
+                           "IQ36_LM_HEAD_I8Q4_TRACE_PATH");
+    if (!path || path[0] == '\0')
+        return;
+    static std::mutex trace_mutex;
+    std::lock_guard<std::mutex> trace_guard(trace_mutex);
+    std::ofstream trace(path, std::ios::app);
+    if (trace)
+        trace << row << '\n';
+}
+
+struct PackedWeightsCache {
+    std::mutex mutex;
+    const void* engine = nullptr;
+    bool binary = false;
+    memory::ptr weights;
+};
+
+PackedWeightsCache& process_packed_weights_cache() {
+    // The locked product has one LM head and one GPU engine per isolated
+    // worker.  Dynamic context buckets create distinct primitive impls, so
+    // retain the read-only packed carrier across those impls.  Intentionally
+    // keep it alive until process exit to avoid plugin/engine teardown order.
+    static auto* cache = new PackedWeightsCache();
+    return *cache;
+}
+
+struct IQ36LMHeadI8Q4Impl : typed_primitive_impl_ocl<fully_connected> {
+    using parent = typed_primitive_impl_ocl<fully_connected>;
+    using parent::parent;
+
+    DECLARE_OBJECT_TYPE_SERIALIZATION(cldnn::ocl::IQ36LMHeadI8Q4Impl)
+
+    IQ36LMHeadI8Q4Impl() = default;
+    explicit IQ36LMHeadI8Q4Impl(const kernel_selector::kernel_data& data) : parent(data) {}
+
+    std::unique_ptr<primitive_impl> clone() const override {
+        return std::make_unique<IQ36LMHeadI8Q4Impl>(*this);
+    }
+
+protected:
+    void prepare_packed_weights(const typed_primitive_inst<fully_connected>& instance,
+                                const memory::ptr& weights,
+                                const memory::ptr& weight_scales) const {
+        if (_weights_source == weights.get() && _scales_source == weight_scales.get())
+            return;
+
+        const auto& weights_layout = weights->get_layout();
+        const auto& scales_layout = weight_scales->get_layout();
+        OPENVINO_ASSERT(weights_layout.data_type == data_types::i8 &&
+                        weights_layout.format == format::bfyx &&
+                        weights_layout.get_linear_size() == kRows * kColumns,
+                        "IQ36 LM-head expected contiguous row-major I8 weights, got ",
+                        weights_layout.to_string());
+        OPENVINO_ASSERT(scales_layout.data_type == data_types::f16 &&
+                        scales_layout.get_linear_size() == kRows,
+                        "IQ36 LM-head expected one F16 scale per row, got ",
+                        scales_layout.to_string());
+
+        const bool binary = binary_enabled();
+        const size_t packed_bytes = binary ? kBinaryPackedBytes : kPackedBytes;
+        auto& engine = instance.get_network().get_engine();
+        auto& packed_cache = process_packed_weights_cache();
+        std::lock_guard<std::mutex> packed_guard(packed_cache.mutex);
+        const bool cache_hit =
+            packed_cache.weights != nullptr && packed_cache.engine == &engine &&
+            packed_cache.binary == binary;
+        if (cache_hit) {
+            _packed_weights = packed_cache.weights;
+        } else {
+        const layout packed_layout(
+            data_types::u8, format::bfyx,
+            tensor(batch(1), feature(static_cast<tensor::value_type>(packed_bytes))));
+        OPENVINO_ASSERT(engine.supports_allocation(allocation_type::usm_device),
+                        "IQ36 LM-head requires USM device allocation for packed weights");
+        _packed_weights = engine.allocate_memory(
+            packed_layout, allocation_type::usm_device, false);
+        auto& stream = instance.get_network().get_stream();
+        mem_lock<int8_t, mem_lock_type::read> source_weights(weights, stream);
+        mem_lock<uint16_t, mem_lock_type::read> source_scales(weight_scales, stream);
+        std::vector<uint8_t> target(packed_bytes, 0);
+        OPENVINO_ASSERT(source_weights.size() == kRows * kColumns &&
+                        source_scales.size() == kRows,
+                        "IQ36 LM-head source or target allocation size differs");
+
+        if (binary) {
+            for (size_t row_group = 0; row_group < kRows / kRowsPerStripe; ++row_group) {
+                auto* stripe = target.data() + row_group * kBinaryStripeBytes;
+                for (size_t lane = 0; lane < kRowsPerStripe; ++lane) {
+                    const size_t row = row_group * kRowsPerStripe + lane;
+                    const size_t row_offset = row * kColumns;
+                    uint32_t histogram[256]{};
+                    for (size_t column = 0; column < kColumns; ++column)
+                        ++histogram[static_cast<uint8_t>(source_weights.data()[row_offset + column])];
+
+                    int64_t low_sum = 0;
+                    int64_t high_sum = 0;
+                    uint32_t low_count = 0;
+                    uint32_t high_count = 0;
+                    for (int value = -128; value <= 127; ++value) {
+                        const auto count = histogram[static_cast<uint8_t>(value)];
+                        if (value < 0) {
+                            low_sum += static_cast<int64_t>(value) * count;
+                            low_count += count;
+                        } else {
+                            high_sum += static_cast<int64_t>(value) * count;
+                            high_count += count;
+                        }
+                    }
+                    float low = static_cast<float>(low_sum) /
+                        static_cast<float>(std::max(1U, low_count));
+                    float high = static_cast<float>(high_sum) /
+                        static_cast<float>(std::max(1U, high_count));
+                    for (int iteration = 0; iteration < 5; ++iteration) {
+                        const float threshold = (low + high) * 0.5f;
+                        low_sum = 0;
+                        high_sum = 0;
+                        low_count = 0;
+                        high_count = 0;
+                        for (int value = -128; value <= 127; ++value) {
+                            const auto count = histogram[static_cast<uint8_t>(value)];
+                            if (static_cast<float>(value) <= threshold) {
+                                low_sum += static_cast<int64_t>(value) * count;
+                                low_count += count;
+                            } else {
+                                high_sum += static_cast<int64_t>(value) * count;
+                                high_count += count;
+                            }
+                        }
+                        if (low_count != 0U)
+                            low = static_cast<float>(low_sum) / static_cast<float>(low_count);
+                        if (high_count != 0U)
+                            high = static_cast<float>(high_sum) / static_cast<float>(high_count);
+                    }
+                    const float threshold = (low + high) * 0.5f;
+                    std::memcpy(stripe + kBinaryCodeBytesPerStripe + lane * sizeof(float),
+                                &low, sizeof(float));
+                    std::memcpy(stripe + kBinaryCodeBytesPerStripe +
+                                    kRowsPerStripe * sizeof(float) + lane * sizeof(float),
+                                &high, sizeof(float));
+                    std::memcpy(stripe + kBinaryCodeBytesPerStripe +
+                                    2 * kRowsPerStripe * sizeof(float) + lane * sizeof(uint16_t),
+                                source_scales.data() + row, sizeof(uint16_t));
+                    for (size_t chunk = 0; chunk < kColumns / 32; ++chunk) {
+                        for (size_t byte = 0; byte < 4; ++byte) {
+                            uint8_t bits = 0;
+                            for (size_t bit = 0; bit < 8; ++bit) {
+                                const size_t column = chunk * 32 + byte * 8 + bit;
+                                const auto value = source_weights.data()[row_offset + column];
+                                if (static_cast<float>(value) > threshold)
+                                    bits |= static_cast<uint8_t>(1U << bit);
+                            }
+                            stripe[chunk * 32 + lane * 4 + byte] = bits;
+                        }
+                    }
+                }
+            }
+        } else {
+            uint8_t code_lut[256]{};
+            for (int value = -128; value <= 127; ++value) {
+                const int signed_code = std::clamp(
+                    static_cast<int>(std::nearbyint(static_cast<float>(value) / 16.0f)), -8, 7);
+                code_lut[static_cast<uint8_t>(value)] = static_cast<uint8_t>(signed_code + 8);
+            }
+            for (size_t row_group = 0; row_group < kRows / kRowsPerStripe; ++row_group) {
+                auto* stripe = target.data() + row_group * kStripeBytes;
+                for (size_t group = 0; group < kGroupsPerRow; ++group) {
+                    auto* block = stripe + group * kCodeBytesPerGroupStripe;
+                    for (size_t chunk = 0; chunk < 16; ++chunk) {
+                        for (size_t lane = 0; lane < kRowsPerStripe; ++lane) {
+                            const size_t row = row_group * kRowsPerStripe + lane;
+                            const size_t row_offset = row * kColumns;
+                            for (size_t element = 0; element < 4; ++element) {
+                                const size_t low = row_offset + group * 128 + chunk * 4 + element;
+                                const size_t high = low + 64;
+                                block[chunk * 32 + lane * 4 + element] = static_cast<uint8_t>(
+                                    code_lut[static_cast<uint8_t>(source_weights.data()[low])] |
+                                    (code_lut[static_cast<uint8_t>(source_weights.data()[high])] << 4));
+                            }
+                        }
+                    }
+                }
+                for (size_t lane = 0; lane < kRowsPerStripe; ++lane) {
+                    const size_t row = row_group * kRowsPerStripe + lane;
+                    std::memcpy(stripe + kCodeBytesPerStripe + lane * sizeof(uint16_t),
+                                source_scales.data() + row, sizeof(uint16_t));
+                }
+            }
+        }
+        _packed_weights->copy_from(stream, target.data(), 0, 0, packed_bytes, true);
+        packed_cache.engine = &engine;
+        packed_cache.binary = binary;
+        packed_cache.weights = _packed_weights;
+        }
+
+        _weights_source = weights.get();
+        _scales_source = weight_scales.get();
+        append_trace(std::string("{\"stage\":\"weight_prepack\",\"node\":\"") + instance.id() +
+                     "\",\"rows\":" + std::to_string(kRows) +
+                     ",\"columns\":" + std::to_string(kColumns) +
+                     ",\"source_weight_bytes\":" + std::to_string(weights->size()) +
+                     ",\"source_scale_bytes\":" + std::to_string(weight_scales->size()) +
+                     ",\"packed_bytes\":" + std::to_string(packed_bytes) +
+                     ",\"packed_allocation\":\"usm_device\"" +
+                     ",\"process_cache_hit\":" + (cache_hit ? "true" : "false") +
+                     ",\"codec\":\"" +
+                         (binary ? "binary_two_centroid_lloyd5" : "signed_q4") + "\"" +
+                     ",\"exact_correction_topk\":" +
+                         std::to_string(binary ? kBinaryLocalTopK : kTopK) +
+                     ",\"exact_correction_rows\":" +
+                         std::to_string(binary ? kBinaryCorrectionRows : kTopK) +
+                     ",\"direct_correction_topk\":" + std::to_string(kTopK) +
+                     ",\"exact_correction_passes\":" +
+                         std::to_string(2) +
+                     ",\"correction_reuses_source_weights\":true" +
+                     ",\"source_weight_format\":\"" + weights_layout.format.to_string() +
+                     "\",\"source_scale_format\":\"" + scales_layout.format.to_string() + "\"}");
+    }
+
+    kernel_arguments_data get_arguments(const typed_primitive_inst<fully_connected>& instance) const override {
+        const auto desc = instance.get_typed_desc<fully_connected>();
+        OPENVINO_ASSERT(desc->dynamic_quantized_activation,
+                        "IQ36 LM-head requires the existing DynamicQuantize producer");
+        const auto& dependency = instance.dependencies().at(0);
+        OPENVINO_ASSERT(dependency.first->type() == dynamic_quantize::type_id(),
+                        "IQ36 LM-head activation must come from DynamicQuantize");
+
+        const auto& source_dependency = dependency.first->dependencies().at(0);
+        auto activation = source_dependency.first->output_memory_ptr(source_dependency.second);
+        auto weights = instance.weights_memory();
+        auto weight_scales = instance.dep_memory_ptr(2);
+        OPENVINO_ASSERT(activation->get_layout().data_type == data_types::f16 &&
+                        activation->get_layout().format == format::bfyx &&
+                        activation->get_layout().get_linear_size() == kColumns &&
+                        instance.output_memory_ptr(0)->get_layout().format == format::bfyx &&
+                        instance.output_memory_ptr(0)->get_layout().get_linear_size() == kRows,
+                        "IQ36 LM-head runtime layout differs from the locked contiguous contract");
+        prepare_packed_weights(instance, weights, weight_scales);
+
+        kernel_arguments_data args;
+        args.inputs = {activation, weights, weight_scales};
+        args.weights = _packed_weights;
+        args.outputs = {instance.output_memory_ptr(0)};
+        return args;
+    }
+
+private:
+    mutable memory::ptr _packed_weights;
+    mutable const memory* _weights_source = nullptr;
+    mutable const memory* _scales_source = nullptr;
+};
