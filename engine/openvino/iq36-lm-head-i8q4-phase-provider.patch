+    "fullyconnectedcompressed:__module.model.lm_head/ov_ext::linear/MatMul";
+constexpr char kQuantizeKernelName[] = "iq36_lm_head_q8_group256_f16";
+constexpr char kMatvecKernelName[] = "iq36_lm_head_i8q4_rowstripe8_matvec_topk8_f16";
+constexpr char kOutputSelectKernelName[] = "iq36_lm_head_output_topk8_f16";
+constexpr char kMergeKernelName[] = "iq36_lm_head_topk8_merge_f32";
