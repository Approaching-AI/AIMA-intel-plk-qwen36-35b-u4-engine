+    using argument_type = kernel_selector::kernel_argument_types;
+    auto& quantize = data.kernels[0];
+    quantize.code.kernelString = std::make_shared<kernel_selector::kernel_string>();
+    quantize.code.kernelString->entry_point = kBinaryQuantizeKernelName;
+    quantize.code.kernelString->str = source;
+    quantize.code.kernelString->options =
