+IQ36LMHeadI8Q4ImplementationManager::IQ36LMHeadI8Q4ImplementationManager()
+    : ImplementationManager(impl_types::onednn, shape_types::static_shape) {}
+
+bool IQ36LMHeadI8Q4ImplementationManager::validate_impl(const program_node& node) const {
+    if (!enabled() || !node.is_type<fully_connected>())
+        return false;
+    if (node.id() != kNodeId)
+        return false;
+    const auto& fc = node.as<fully_connected>();
+    const auto desc = fc.get_primitive();
+    if (desc->bias.is_valid() || !desc->compressed_weights ||
+        !desc->decompression_scale.is_valid() || desc->decompression_zero_point.is_valid() ||
+        desc->decompression_zero_point_scalar.has_value() || !desc->dynamic_quantized_activation ||
+        desc->dynamic_quantized_activation_zp || desc->dynamic_quantized_precomputed_reduction ||
+        node.get_dependencies().size() != 4 || !node.get_dependency(0).is_type<dynamic_quantize>()) {
+        return false;
+    }
+    const auto& weights = node.get_dependency(1).get_output_layout();
+    const auto& scales = node.get_dependency(2).get_output_layout();
+    if (!weights.is_static() || !scales.is_static() || weights.data_type != data_types::i8 ||
+        scales.data_type != data_types::f16 || logical_size(weights) != kRows * kColumns ||
+        logical_size(scales) != kRows || weights.format != format::bfyx) {
+        return false;
+    }
+    const auto& source = node.get_dependency(0).get_dependency(0).get_output_layout();
+    return source.data_type == data_types::f16;
+}
+
+bool IQ36LMHeadI8Q4ImplementationManager::support_shapes(const kernel_impl_params& params) const {
+    return has_exact_static_contract(params);
+}
+
+std::unique_ptr<primitive_impl> IQ36LMHeadI8Q4ImplementationManager::create_impl(
+    const program_node&, const kernel_impl_params& params) const {
+    if (!has_exact_static_contract(params))
+        return nullptr;
+    const bool binary = binary_enabled();
+    auto data = binary ? make_binary_kernel_data() : make_kernel_data();
+    append_trace(std::string("{\"stage\":\"selection\",\"node\":\"") + params.desc->id +
+                 "\",\"tokens\":1,\"rows\":" + std::to_string(kRows) +
+                 ",\"columns\":" + std::to_string(kColumns) +
+                 ",\"packed_bytes\":" +
+                     std::to_string(binary ? kBinaryPackedBytes : kPackedBytes) +
+                 ",\"topk\":" +
+                     std::to_string(binary ? kBinaryLocalTopK : kTopK) +
+                 ",\"correction_rows\":" +
+                     std::to_string(binary ? kBinaryCorrectionRows : kTopK) +
+                 ",\"provider\":\"" +
+                 (binary ?
+                    std::string(kBinaryQuantizeKernelName) + "+" +
+                        kBinaryMatvecKernelName + "+" + kBinaryCorrectionKernelName + "+" +
+                        kOutputSelectKernelName + "+" + kMergeKernelName + "+" +
+                        kDirectCorrectionKernelName :
+                    std::string(kQuantizeKernelName) + "+" + kMatvecKernelName + "+" +
+                        kMergeKernelName + "+" + kCorrectionKernelName + "+" +
+                        kOutputSelectKernelName + "+" + kMergeKernelName + "+" +
+                        kDirectCorrectionKernelName) +
+                 "\",\"direct_correction_topk\":" + std::to_string(kTopK) +
+                 ",\"correction_passes\":" + std::to_string(2) +
+                 ",\"global\":[248320,1,1],\"local\":[256,1,1]}");
+    return std::make_unique<IQ36LMHeadI8Q4Impl>(data);
+}
