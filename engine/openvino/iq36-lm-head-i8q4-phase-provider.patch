+constexpr size_t kRows = 248320;
+constexpr size_t kColumns = 2048;
+constexpr size_t kRowsPerStripe = 8;
+constexpr size_t kGroupsPerRow = 16;
+constexpr size_t kCodeBytesPerGroupStripe = 512;
+constexpr size_t kCodeBytesPerStripe = 8192;
+constexpr size_t kStripeBytes = 8224;
