+__kernel void iq36_lm_head_i8q1_gated_q4_correction_f16(
+    __global const char* weights,
+    __global const half* weight_scales,
+    __global const half* input,
+    __global const uint* state,
+    __global const int* selected_ids,
+    __global half* output) {
+  if (state[0] < IQ36_BINARY_GATED_EXACT_COUNT) return;
+  const uint selected = (uint)get_group_id(0);
+  const uint lane = (uint)get_local_id(0);
+  const uint count = min(
+      state[2], (uint)IQ36_BINARY_GATED_Q4_CORRECTION_CAPACITY);
+  if (selected >= count) return;
