+__kernel void iq36_lm_head_i8q1_gated_q4_matvec_f16(
+    __global const uchar* packed,
+    __global const char* q8_qs,
+    __global const float* q8_d,
+    __global const uint* state,
+    __global half* output) {
+  if (state[0] < IQ36_BINARY_GATED_EXACT_COUNT) return;
+  const uint row = (uint)get_global_id(0);
+  if (row < IQ36_ROWS) {
+    output[row] = convert_half_rte(iq36_lm_head_i8q1_gated_q4_dot(
+        packed, q8_qs, q8_d, (ulong)row));
+  }
+}
+#endif
