+#if defined(IQ36_BINARY_GATED_Q4_COLLECT_KERNEL)
+__attribute__((reqd_work_group_size(256, 1, 1)))
+__kernel void iq36_lm_head_i8q1_gated_q4_collect_f16(
+    __global const half* output,
+    volatile __global uint* state,
+    __global int* selected_ids) {
+  if (state[0] < IQ36_BINARY_GATED_EXACT_COUNT) return;
+  const uint row = (uint)get_global_id(0);
+  if (row >= IQ36_ROWS) return;
+  const float exact_maximum =
+      as_float(state[1]) + IQ36_BINARY_GATED_EXACT_DELTA;
+  if (convert_float(output[row]) <
+      exact_maximum - IQ36_BINARY_GATED_Q4_CORRECTION_DELTA) return;
+  const uint slot = atomic_inc(state + 2);
+  if (slot < IQ36_BINARY_GATED_Q4_CORRECTION_CAPACITY)
+    selected_ids[slot] = (int)row;
+}
+#endif
