diff --git a/src/plugins/intel_gpu/src/graph/primitive_inst.cpp b/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
--- a/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
+++ b/src/plugins/intel_gpu/src/graph/primitive_inst.cpp
@@ -2,6 +2,7 @@
 // SPDX-License-Identifier: Apache-2.0
 //
 
+#include <cstdlib>
 #include <sstream>
 
 #include "intel_gpu/graph/kernel_impl_params.hpp"
@@ -726,6 +727,68 @@ void primitive_inst::realloc_outputs(bool prev_execution_skipped) {
         }
     }
 
+    // A runtime-skipped dynamic quantize aliases its activation input and does
+    // not allocate quantized/scales buffers. The generic path below updates FC
+    // users early, recomputes FC fake alignment and DQ scale layouts, then
+    // discards those local results at the optimized-out return. When no user
+    // has already received an early shape update, leave that work to each FC's
+    // own prepare_primitive() call in topological order and take the same
+    // optimized-out memory exit directly.
+    const char* iq36_dq_fastpath_env =
+        std::getenv("IQ36_GPU_DQ_REALLOC_FASTPATH");
+    const bool iq36_dq_fastpath =
+        iq36_dq_fastpath_env != nullptr &&
+        iq36_dq_fastpath_env[0] != '\0' &&
+        iq36_dq_fastpath_env[0] != '0' &&
+        get_node().is_type<dynamic_quantize>() &&
+        get_node().is_runtime_skippable() && can_be_optimized() &&
+        _impl_params->get_output_layout(0).data_type == data_types::f16;
+    if (iq36_dq_fastpath) {
+        bool exact_fastpath_eligible = !users.empty();
+        for (auto* user : users) {
+            if (!user->get_node().is_type<fully_connected>() ||
+                !user->is_dynamic() || user->_deps.empty() ||
+                user->_deps[0].first != this ||
+                user->_update_shape_done_by_other) {
+                exact_fastpath_eligible = false;
+                break;
+            }
+        }
+
+        if (exact_fastpath_eligible) {
+            _max_output_layout_count =
+                _deps[0].first->_max_output_layout_count;
+            if (_outputs[0] && dep_memory_ptr(0) &&
+                !get_network().get_engine().is_the_same_buffer(
+                    dep_memory(0), output_memory(0))) {
+                std::function<void(primitive_inst*, memory::ptr)>
+                    reset_user_output_memory =
+                        [&](primitive_inst* curr_inst,
+                            memory::ptr target_mem_ptr) {
+                            for (auto* user_inst :
+                                 curr_inst->get_user_insts()) {
+                                auto curr_output_memory_ptr =
+                                    user_inst->output_memory_ptr(0);
+                                if (user_inst->can_be_optimized() &&
+                                    curr_output_memory_ptr &&
+                                    get_network().get_engine()
+                                        .is_the_same_buffer(
+                                            *curr_output_memory_ptr,
+                                            *target_mem_ptr)) {
+                                    user_inst->clear_output_memory();
+                                    reset_user_output_memory(
+                                        user_inst, target_mem_ptr);
+                                }
+                            }
+                        };
+                reset_user_output_memory(this, dep_memory_ptr(0));
+            }
+            GPU_DEBUG_PROFILED_STAGE_MEMALLOC_INFO(
+                "iq36_dq_runtime_skip_defer_fc_shape");
+            return;
+        }
+    }
+
     // Update param if fake_alignment is available
     auto updated_params = get_fake_aligned_params_if_possible(get_node(), *_impl_params);
 
