+#ifdef ENABLE_ONEDNN_FOR_GPU
+    // Generated microkernel shims carry their machine-code package in the
+    // OpenCL source.  Mark custom kernels that contain such a package so the
+    // normal kernels-cache path performs the existing post-compile fusion.
+    // A phase-specialized custom layer may carry distinct generated prefill
+    // and decode shims in one source bundle.  Remove the inactive marked
+    // region before compilation so each static shape exposes exactly one
+    // microkernel package to the fuser.
+    constexpr std::string_view prefill_begin =
+        "// IQ36_EMBEDDED_MICROKERNEL_PREFILL_BEGIN";
+    constexpr std::string_view prefill_end =
+        "// IQ36_EMBEDDED_MICROKERNEL_PREFILL_END";
+    constexpr std::string_view decode_begin =
+        "// IQ36_EMBEDDED_MICROKERNEL_DECODE_BEGIN";
+    constexpr std::string_view decode_end =
+        "// IQ36_EMBEDDED_MICROKERNEL_DECODE_END";
+    auto& source = cl_kernel->code.kernelString->str;
+    if (phase_specialized_fixed_fc) {
+        const auto select_region = [&](std::string_view begin_marker,
+                                       std::string_view end_marker,
+                                       bool selected) {
+            const auto begin = source.find(begin_marker);
+            OPENVINO_ASSERT(begin != std::string::npos,
+                            "Missing IQ36 fixed-FC microkernel begin marker");
+            const auto end_position = source.find(end_marker, begin);
+            OPENVINO_ASSERT(end_position != std::string::npos,
+                            "Missing IQ36 fixed-FC microkernel end marker");
+            if (!selected) {
+                const auto end = end_position + end_marker.size();
+                source.erase(begin, end - begin);
+            }
+        };
+        select_region("// IQ36_FIXED_FC_DECODE_BEGIN",
+                      "// IQ36_FIXED_FC_DECODE_END",
+                      !fixed_fc_prefill);
+        select_region("// IQ36_FIXED_FC_PREFILL_WIDE_BEGIN",
+                      "// IQ36_FIXED_FC_PREFILL_WIDE_END",
+                      fixed_fc_prefill && fixed_fc_wide);
+        select_region("// IQ36_FIXED_FC_PREFILL_SMALL_BEGIN",
+                      "// IQ36_FIXED_FC_PREFILL_SMALL_END",
+                      fixed_fc_prefill && !fixed_fc_wide);
+        cl_kernel->code.kernelString->has_microkernels =
+            gemmstone::microkernel::hasMicrokernels(source.c_str());
+    } else if (source.find(prefill_begin) != std::string::npos ||
+               source.find(decode_begin) != std::string::npos) {
+        const auto input_shape = impl_param.get_input_layout(0).get_partial_shape();
+        const bool is_prefill = input_shape.rank().is_static() &&
+                                input_shape.rank().get_length() > 2 &&
+                                input_shape[2].is_static() &&
+                                input_shape[2].get_length() > 1;
+        const auto remove_region = [&](std::string_view begin_marker,
+                                       std::string_view end_marker) {
+            const auto begin = source.find(begin_marker);
+            if (begin == std::string::npos)
+                return;
+            const auto end_position = source.find(end_marker, begin);
+            OPENVINO_ASSERT(end_position != std::string::npos,
+                            "Missing embedded microkernel end marker");
+            const auto end = end_position + end_marker.size();
+            source.erase(begin, end - begin);
+        };
+        if (is_prefill)
+            remove_region(decode_begin, decode_end);
+        else
+            remove_region(prefill_begin, prefill_end);
+        cl_kernel->code.kernelString->has_microkernels =
+            gemmstone::microkernel::hasMicrokernels(source.c_str());
+    } else {
+        cl_kernel->code.kernelString->has_microkernels =
+            gemmstone::microkernel::hasMicrokernels(source.c_str());
+    }
+#endif
