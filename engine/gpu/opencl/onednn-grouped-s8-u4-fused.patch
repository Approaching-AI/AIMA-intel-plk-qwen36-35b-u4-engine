+        off_t sg_i0 = wg_i0 + sg_i * ugemm_grouped_sg_tile_m;
+        off_t sg_j0 = wg_j0;
+        const global char *task_src = src + src_offset * ldsrc;
+        global DST_DATA_T *task_dst = dst + src_offset * lddst;
+        const global float *task_src_scales
+                = src_scales + src_offset * ldsrcq;
+        const global char *task_sum_low
+                = sum_low + src_offset * (k / 32);
+        const global char *task_sum_high
+                = sum_high + src_offset * (k / 32);
+        const global float *task_router_weights
+                = router_weights + src_offset;
+        const global uchar *task_wei
