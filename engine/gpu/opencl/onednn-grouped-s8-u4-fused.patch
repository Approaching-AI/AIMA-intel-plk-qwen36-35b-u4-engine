+float iq36_silu(float value) {
+    float sigmoid = value >= 0.0f ? 1.0f / (1.0f + exp(-value))
+                                  : exp(value) / (1.0f + exp(value));
+    return value * sigmoid;
+}
+
+#if defined(SRC_DT_S8)
+short iq36_pack_i8_pair(char low, char high) {
+    ushort packed = (ushort)((uchar)low)
+            | ((ushort)((uchar)high) << 8);
+    return as_short(packed);
+}
+
+uint8 iq36_load_min_codes(const global uchar *codes, int output, int block,
+        int blocks, int n) {
+    if (output >= n) return (uint8)(0);
+    uchar8 values = vload8(0, codes + (output * blocks + block) * 8);
+    uint2 packed = as_uint2(values);
+    return (uint8)(packed.s0, packed.s1, 0, 0, 0, 0, 0, 0);
+}
+
+void iq36_subtract_compact_s8(ugemm_grouped_c_type *tile,
+        const global char *sum_low, const global char *sum_high,
+        const global uchar *min_codes, const global float *dmins,
+        const global float *src_scales, int n, int m, int blocks, int ldsrcq,
+        int sg_i0, int sg_j0) {
+    int lane = get_sub_group_local_id();
+    int output0 = sg_i0 + lane;
+    int output1 = output0 + 16;
+    int groups = blocks * 8;
+    for (int block = 0; block < blocks; ++block) {
+        short8 low_pairs = (short8)(0);
+        short8 high_pairs = (short8)(0);
+        float8 row_scales = (float8)(0.0f);
+        for (int row_in_tile = 0; row_in_tile < 8; ++row_in_tile) {
+            int row = sg_j0 + row_in_tile;
+            if (row < m) {
+                row_scales[row_in_tile]
+                        = src_scales[row * ldsrcq + block];
+                if (lane < 4) {
+                    int group = block * 8 + lane * 2;
+                    low_pairs[row_in_tile] = iq36_pack_i8_pair(
+                            sum_low[row * groups + group],
+                            sum_low[row * groups + group + 1]);
+                    high_pairs[row_in_tile] = iq36_pack_i8_pair(
+                            sum_high[row * groups + group],
+                            sum_high[row * groups + group + 1]);
+                }
+            }
+        }
+        uint8 codes0
+                = iq36_load_min_codes(min_codes, output0, block, blocks, n);
+        uint8 codes1
+                = iq36_load_min_codes(min_codes, output1, block, blocks, n);
+        int8 dot0 = intel_sub_group_i8_u8_matrix_mad_k32(
+                low_pairs, codes0, (int8)(0));
+        int8 dot0_high = intel_sub_group_i8_u8_matrix_mad_k32(
+                high_pairs, codes0, (int8)(0));
+        int8 dot1 = intel_sub_group_i8_u8_matrix_mad_k32(
+                low_pairs, codes1, (int8)(0));
+        int8 dot1_high = intel_sub_group_i8_u8_matrix_mad_k32(
+                high_pairs, codes1, (int8)(0));
+        dot0 += dot0_high * 256;
+        dot1 += dot1_high * 256;
+        float dmin0 = output0 < n ? dmins[output0 * blocks + block] : 0.0f;
+        float dmin1 = output1 < n ? dmins[output1 * blocks + block] : 0.0f;
+        tile->x[0] -= convert_float8(dot0) * row_scales * dmin0;
+        tile->x[1] -= convert_float8(dot1) * row_scales * dmin1;
+    }
+}
+#endif
+#endif
