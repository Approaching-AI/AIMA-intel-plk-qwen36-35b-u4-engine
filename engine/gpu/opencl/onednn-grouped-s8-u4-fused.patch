+    OCL_CHECK(xpu::ocl::clGetProgramInfo(program, CL_PROGRAM_NUM_DEVICES,
+            sizeof(device_count), &device_count, nullptr));
+    std::vector<size_t> sizes(device_count);
+    OCL_CHECK(xpu::ocl::clGetProgramInfo(program, CL_PROGRAM_BINARY_SIZES,
+            sizes.size() * sizeof(size_t), sizes.data(), nullptr));
+    std::vector<std::vector<uint8_t>> programs(device_count);
+    std::vector<uint8_t *> pointers(device_count);
+    for (cl_uint index = 0; index < device_count; ++index) {
+        programs[index].resize(sizes[index]);
+        pointers[index] = programs[index].data();
+    }
+    OCL_CHECK(xpu::ocl::clGetProgramInfo(program, CL_PROGRAM_BINARIES,
+            pointers.size() * sizeof(uint8_t *), pointers.data(), nullptr));
+    for (cl_uint index = 0; index < device_count; ++index) {
+        CHECK(gpu_utils::dump_kernel_binary(
+                programs[index], name() + "_program"));
+    }
